# Copy this file to ".env" and fill in real values.
# The app runs fine without a .env file at all - Gmail sending is
# simply disabled and emails are printed to the console instead.

# A long random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Optional: point at a different database (Postgres, MySQL, etc).
# Leave unset to use the default local SQLite file (app.db).
# DATABASE_URL=postgresql://user:password@localhost:5432/taskflow

# --- Gmail SMTP (App Password) ---
# 1. Enable 2-Step Verification on the Gmail account:
#    https://myaccount.google.com/security
# 2. Create an "App Password" here (select "Mail" as the app):
#    https://myaccount.google.com/apppasswords
# 3. Paste the sending address and the 16-character app password below.
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# --- Scheduler tuning (optional) ---
# How often (hours) the background job checks for tasks due soon.
DUE_DATE_CHECK_INTERVAL_HOURS=24
# How far ahead (hours) counts as "due soon" for the reminder email.
DUE_DATE_WARNING_WINDOW_HOURS=24

# --- Project invitations (optional) ---
# How many hours a generated invite link stays valid before expiring.
INVITE_EXPIRY_HOURS=72

# --- Automatic database migration on startup (optional) ---
# When true (default), app.py brings the DB schema up to date every
# time it starts - no manual `flask db upgrade` needed. Set to false
# to manage migrations yourself as an explicit step instead.
AUTO_MIGRATE=true

# --- Gmail API OAuth2 (optional, additive on top of SMTP above) ---
# Only needed if you want invite/message notifications to send via
# the real Gmail API instead of SMTP. See README "Setting up the
# real Gmail API (OAuth2)" for the one-time setup script that
# produces token.json. Leave unset to use the defaults
# (client_secret.json / token.json in the project root).
# GOOGLE_OAUTH_CLIENT_SECRETS_FILE=client_secret.json
# GOOGLE_OAUTH_TOKEN_FILE=token.json
