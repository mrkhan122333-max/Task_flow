# =========================================================================
#  Cosmic Info Solutions — Task Management
#  Production environment configuration
# =========================================================================
#  Copy to ".env" and fill in real values:
#      cp .env.example .env
#  Then generate the two secrets (see below). NEVER commit .env.
#
#  Deployed at https://tasks.cosmicinfosolutions.com
# =========================================================================

# -------------------------------------------------------------------------
# Runtime
# -------------------------------------------------------------------------
# "production" is mandatory in production: it turns off development behaviour,
# sends generic error pages, and marks cookies Secure.
NODE_ENV=production

# Single Node process, bound to loopback/all interfaces for the reverse proxy.
# Never expose this port directly to the internet — Nginx is the only entry point.
PORT=4321
HOST=0.0.0.0

# Leave BASE_PATH empty: the app is served from the domain root.
# Only set it (e.g. BASE_PATH=/tasks) if you must host under a subdirectory.
BASE_PATH=

# -------------------------------------------------------------------------
# Secrets  (REQUIRED — the server refuses to start in production without them)
# -------------------------------------------------------------------------
# 32+ random bytes, e.g.:  openssl rand -hex 32
# or in PowerShell:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server exits at startup if this is empty, shorter than 32 characters, or
# still set to the CHANGE_ME placeholder below.
SESSION_SECRET=CHANGE_ME_64_HEX_CHARACTERS_RANDOM_STRING_0000000000000000

# Only used when BASE_PATH is empty and you want the canonical origin for
# absolute links (e-mail notifications, redirects).
PUBLIC_URL=https://tasks.cosmicinfosolutions.com

# -------------------------------------------------------------------------
# Reverse proxy
# -------------------------------------------------------------------------
# Number of trusted proxy hops for X-Forwarded-For / X-Forwarded-Proto.
# 1 = one Nginx/Caddy/load balancer in front. Add one per extra proxy layer.
# This is what makes the app see the real client IP and know the request was HTTPS.
TRUST_PROXY_HOPS=1

# -------------------------------------------------------------------------
# Persistence  (these paths MUST be on a persistent volume)
# -------------------------------------------------------------------------
# JSON database (users, projects, tasks, comments, files metadata, audit trail).
DATA_DIR=./data
# Uploaded attachments.
UPLOAD_DIR=./uploads

# -------------------------------------------------------------------------
# Session + upload limits
# -------------------------------------------------------------------------
SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=25

# Sessions are marked "Secure" automatically when NODE_ENV=production and the
# request arrived over HTTPS. Set to false only for local HTTP testing.
COOKIE_SECURE=true

# -------------------------------------------------------------------------
# SMTP  (optional — only needed for password-reset e-mails)
# -------------------------------------------------------------------------
# When SMTP_HOST is empty, password resets are handled entirely in the admin UI
# (the generated password is shown once and never stored in plain text).
# Filling in SMTP_HOST enables sending automatically; set SMTP_ENABLED=false to
# keep stored credentials parked without sending anything.
#
# TLS is mandatory. Port 587 with SMTP_SECURE=false upgrades via STARTTLS; port
# 465 uses implicit TLS. The mailer refuses to authenticate over a plaintext
# connection, so a temporary password is never exposed on the wire.
SMTP_HOST=
SMTP_ENABLED=
SMTP_PORT=587
SMTP_SECURE=false          # true for implicit TLS (usually port 465)
SMTP_USER=
SMTP_PASS=
# Either a single RFC 5322 sender...
# SMTP_FROM=Cosmic Info Solutions Task Management <notifications@cosmicinfosolutions.com>
# ...or the name/address pair below, which is combined automatically.
SMTP_FROM_NAME=Cosmic Info Solutions Task Management
SMTP_FROM_EMAIL=notifications@cosmicinfosolutions.com

# -------------------------------------------------------------------------
# First Admin account
# -------------------------------------------------------------------------
# Read once by "npm run seed". Change these before running it, or pass the
# values on the command line instead. Remove them from .env afterwards.
COSMIC_ADMIN_USERNAME=admin
COSMIC_ADMIN_PASSWORD=
COSMIC_ADMIN_ROLE=admin
COSMIC_ADMIN_NAME=System Administrator
COSMIC_ADMIN_EMAIL=admin@cosmicinfosolutions.com
COSMIC_ADMIN_DEPARTMENT=IT
COSMIC_ADMIN_DESIGNATION=System Administrator
