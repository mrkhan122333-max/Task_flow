# ===== TaskFlow environment configuration =====
# Copy this file to ".env" and adjust as needed. All values are optional.

# HTTP server port (single process). The web server (Nginx/Apache) reverse-proxies
# /taskflow/ to this port.
PORT=4321

# Bind host. 0.0.0.0 = all interfaces (use this only when behind a reverse proxy).
HOST=0.0.0.0

# Optional subdirectory base path if you reverse-proxy WITHOUT stripping the prefix,
# e.g. BASE_PATH=/taskflow. Leave empty when your proxy strips the prefix
# (recommended: proxy_pass with a trailing slash).
BASE_PATH=

# Where JSON data + uploads live (relative to project root, or absolute).
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Session lifetime (days) before users must sign in again.
SESSION_TTL_DAYS=30

# Maximum upload size in MB.
MAX_UPLOAD_MB=25

# Set to "true" only when the site is served over HTTPS (cookies get the Secure flag).
COOKIE_SECURE=false

# development | production
NODE_ENV=development