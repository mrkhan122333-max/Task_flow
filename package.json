{
  "name": "cosmic-tasks",
  "version": "1.0.0",
  "private": true,
  "description": "Cosmic Info Solutions Task Management — task assignment, tracking, deadlines and audit history",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "serve": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
